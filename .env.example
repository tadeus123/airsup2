SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
AIRSUP_DB_TOKEN=your_server_db_token

# Orgo relay — routes talk_to_user to peer's ChatGPT browser VM
ORGO_API_KEY=sk_live_...
# Optional legacy fallback if a user has no orgo_computer_id in Supabase yet:
# ORGO_COMPUTER_MAP={"tade1":"099c33f0-..."}
# ORGO_DEFAULT_COMPUTER_ID=099c33f0-...
# ORGO_RELAY_MODE=auto
# auto = hotkeys first, agent fallback | direct = hotkeys only | agent = full agent loop (slow)
# ORGO_POLL_INTERVAL_MS=2000
# ORGO_MIN_WAIT_SEC=3
# ORGO_REPLY_STABLE_POLLS=2
# ORGO_COPY_TIMEOUT_MS=45000
# ORGO_MODEL=claude-sonnet-5
# ORGO_TIMEOUT_MS=120000
# Max parallel new-chat relays per Orgo computer (different conversations at once)
# ORGO_MAX_CONCURRENT_RELAYS=2
